+/// Return why a cached view cannot replay its previous output, or `None` when
+/// it can.
+fn view_cache_miss(
+    entity_id: EntityId,
+    element_state: Option<&ViewElementState>,
+    bounds: Bounds<Pixels>,
+    content_mask: &ContentMask<Pixels>,
+    text_style: &TextStyle,
+    opacity: f32,
+    window: &Window,
